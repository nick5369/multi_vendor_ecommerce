# Copy to .env and fill in LOCAL DEVELOPMENT values. Never commit .env.
# Generate strong random values with: scripts/gen-secrets.sh  (fills a .env for you)

# ---- Host ports (all bound to 127.0.0.1) ----
GATEWAY_PORT=8080            # Traefik API entrypoint: http://localhost:8080/api/...
WEB_PORT=5173                # React frontend
RABBITMQ_MGMT_PORT=15672     # RabbitMQ management UI
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
PUBLIC_GATEWAY_URL=http://localhost:8080   # API base URL baked into the frontend build
CORS_ORIGINS=http://localhost:5173         # comma-separated allowed browser origins

# ---- Auth / JWT (RS256) ----
# Run scripts/gen-keys.sh to produce these (base64 of PEM). Only auth-service signs; others verify via JWKS.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=mve-auth
JWT_AUDIENCE=mve-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
# Shared secret for service-to-service (private) endpoints. Random 32+ chars.
INTERNAL_SERVICE_TOKEN=
# Local-only admin bootstrap (seed script creates this ADMIN if both set). Non-production use only.
ADMIN_SEED_EMAIL=admin@local.test
ADMIN_SEED_PASSWORD=
MAIL_MODE=log                # log = print emails/tokens to service logs (dev only)
# Local-only demo sellers/customers (all @demo.local, labelled NON-PRODUCTION). Never enable outside a dev machine.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=

# ---- MongoDB (auth-service) ----
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_DB=auth
MONGO_APP_USER=auth_app
MONGO_APP_PASSWORD=

# ---- Catalog PostgreSQL ----
CATALOG_DB=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=

# ---- Order MySQL ----
MYSQL_ROOT_PASSWORD=
MYSQL_DB=orders
MYSQL_APP_USER=orders_app
MYSQL_APP_PASSWORD=

# ---- Inventory PostgreSQL ----
INVENTORY_DB=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=

# ---- Payment PostgreSQL ----
PAYMENT_DB=payments
PAYMENT_DB_USER=payments
PAYMENT_DB_PASSWORD=

# ---- Redis (cache only) ----
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=120

# ---- RabbitMQ ----
RABBITMQ_USER=mve
RABBITMQ_PASSWORD=

# ---- Business settings ----
CART_MAX_QUANTITY=1000       # per cart line
RESERVATION_TTL_SECONDS=900  # stock reservation expiry policy

# ---- Payments ----
# razorpay = real Razorpay TEST mode (default target). mock = local fake gateway, NEVER counts as Razorpay verification.
PAYMENT_GATEWAY=razorpay
# TEST-mode credentials only (rzp_test_...). Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Used ONLY when PAYMENT_GATEWAY=mock (offline dev/automated tests). Random values; unrelated to Razorpay.
MOCK_GATEWAY_SECRET=
MOCK_WEBHOOK_SECRET=

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
